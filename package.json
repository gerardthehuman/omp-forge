{
  "name": "omp-forge-marketplace",
  "private": true,
  "workspaces": [
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "oxlint --type-aware --type-check . && oxfmt --check .",
    "fix": "oxlint --type-aware --type-check --fix . && oxfmt --write .",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.6.1",
    "@oh-my-pi/pi-coding-agent": "18.6.1",
    "@types/bun": "1.3.10",
    "lefthook": "2.2.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.2"
}
