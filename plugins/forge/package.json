{
  "name": "omp-forge",
  "version": "1.0.1",
  "description": "Forge provider, live model metadata, and MCP for OMP",
  "type": "module",
  "private": true,
  "engines": { "bun": ">=1.3.0" },
  "scripts": {
    "build": "bun build mcp.mjs --target=bun --format=esm --packages=bundle --env=disable --minify-syntax --outfile=dist/mcp.mjs"
  },
  "omp": {
    "extensions": ["index.mjs"]
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
