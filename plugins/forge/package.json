{
  "name": "omp-forge",
  "version": "1.0.0",
  "private": true,
  "description": "Forge provider, live model metadata, and MCP for OMP",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts src/mcp.ts --target=bun --format=esm --packages=bundle --env=disable --minify-syntax --outdir=dist",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "omp": {
    "extensions": [
      "dist/index.js"
    ]
  }
}
