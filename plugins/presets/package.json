{
  "name": "omp-model-presets",
  "version": "1.0.0",
  "private": true,
  "description": "Native model presets with session-only activation",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --format=esm --packages=external --env=disable --minify-syntax --outdir=dist",
    "typecheck": "tsc --project tsconfig.json",
    "test": "bun test src"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "omp": {
    "extensions": [
      "dist/index.js"
    ]
  }
}
